{
  "//": "Type-checking only. This project ships ZERO dependencies and has NO build step. Types are expressed with JSDoc so that `npx tsc --noEmit` fully checks the codebase while `node server.js` still runs it directly.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["lib/**/*.js", "bin/**/*.js", "server.js", "public/js/**/*.js"],
  "exclude": ["node_modules", "data/runtime"]
}
