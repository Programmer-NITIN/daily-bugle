# ============================================================
#  THE DAILY BUGLE — environment
#  Copy to `.env` and fill in. NEVER commit the real `.env`.
# ============================================================

# ------------------------------------------------------------
#  DATA MODE
# ------------------------------------------------------------
# fixture -> run entirely from committed snapshots in data/.
#            No credentials needed. This is the default so that
#            anyone can clone the repo and get a working app.
# live     -> hit the real Bright Data Scraper Studio API using
#             the collector IDs below.
BUGLE_MODE=fixture

# ------------------------------------------------------------
#  BRIGHT DATA
# ------------------------------------------------------------
# Get your token: https://brightdata.com  ->  Account settings -> API tokens
# Only required when BUGLE_MODE=live
BRIGHTDATA_API_TOKEN=

# Base URL for the Scraper Studio trigger API.
BRIGHTDATA_API_BASE=https://api.brightdata.com

# ------------------------------------------------------------
#  COLLECTOR IDS  (produced by Scraper Studio)
# ------------------------------------------------------------
# Create one per target with the CLI, e.g.
#
#   npx -p @brightdata/cli bdata login
#   bdata scraper create https://pocketbase.io/release-notes/ \
#     "Extract every release entry: version tag, release date, and each
#      changelog bullet with its type (feature, fix, breaking)."
#
# The command prints a collector id shaped like c_xxxxxxxxxxxx.
# Paste it here, then set BUGLE_MODE=live.
COLLECTOR_POCKETBASE=
COLLECTOR_COOLIFY=
COLLECTOR_UMAMI=
COLLECTOR_MEILISEARCH=
COLLECTOR_TYPST=
COLLECTOR_CADDY=
COLLECTOR_TURSO=
COLLECTOR_ZED=

# ------------------------------------------------------------
#  SELF-HEALING
# ------------------------------------------------------------
# The bar a payload must clear (0-100) AFTER healing for the repair to
# count as verified. The decision to heal in the first place is made on
# the Spider-Sense status (anything not `ok`), not on this number.
HEAL_THRESHOLD=60

# Set to 1 to allow the orchestrator to actually shell out to the
# bdata CLI. Left at 0, healing is planned and logged but not executed
# (safe default so a demo run never burns credits unexpectedly).
HEAL_EXECUTE=0

# ------------------------------------------------------------
#  SERVER
# ------------------------------------------------------------
PORT=4830
